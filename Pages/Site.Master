<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="DepartmentModule.Pages.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Department Project & tender</asp:ContentPlaceHolder></title>
    <link href="<%= ResolveUrl("~/Content/Styles.css?v=20261126-list-pagination-v1") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="ModuleForm" runat="server" enctype="multipart/form-data">
        <div id="AppLayout" runat="server" class="app-shell public-layout">
            <aside id="AdminSidebar" runat="server" class="sidebar" visible="false">
                <div class="sidebar-top">
                    <div class="sidebar-heading">Project & tender <span><asp:Literal ID="SidebarSubtitle" runat="server" /></span></div>
                    <button type="button" id="SidebarCollapseToggle" class="sidebar-collapse-toggle"
                        aria-controls="AdminSidebar" aria-expanded="true" aria-label="Collapse sidebar" title="Collapse sidebar">
                        <svg class="sidebar-collapse-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                        <svg class="sidebar-close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <asp:PlaceHolder ID="SidebarNavigation" runat="server" />
                <div class="sidebar-account">
                    <asp:Literal ID="CurrentUser" runat="server" />
                    <asp:LinkButton ID="SignOutLink" runat="server" CssClass="side-nav-link signout-link" OnClick="SignOutLink_Click" Visible="false">Sign out</asp:LinkButton>
                </div>
            </aside>
            <button type="button" id="SidebarScrim" class="sidebar-scrim" aria-label="Close navigation menu" tabindex="-1"></button>
            <div class="app-main">
                <header class="topbar">
                    <button type="button" id="SidebarToggle" class="sidebar-toggle" aria-controls="AdminSidebar" aria-expanded="false" aria-label="Open navigation menu">
                        <span></span><span></span><span></span>
                    </button>
                    <a class="brand" href="<%= ResolveUrl("~/Pages/Home.aspx") %>">
                        <img class="brand-logo" src="<%= ResolveUrl("~/SMC.png") %>" alt="" />
                        <span class="brand-copy">Solapur Municipal Corporation <span>Project & tender System</span></span>
                    </a>
                    <button type="button" id="PublicNavToggle" class="public-nav-toggle" aria-controls="PublicNavigation" aria-expanded="false" aria-label="Open navigation menu">
                        <span></span><span></span><span></span>
                    </button>
                    <button type="button" id="PublicNavClose" class="public-nav-close" aria-label="Close navigation menu">X</button>
                    <nav id="PublicNavigation" runat="server" class="primary-nav" aria-label="Primary navigation">
                        <a href="<%= ResolveUrl("~/Pages/Home.aspx") %>">Home</a>
                        <asp:HyperLink ID="TendersLink" runat="server" NavigateUrl="~/Pages/Home.aspx#published-tenders">Tenders</asp:HyperLink>
                        <a href="<%= ResolveUrl("~/Pages/Home.aspx#announcements") %>">Notices</a>
                        <asp:HyperLink ID="DashboardLink" runat="server" NavigateUrl="~/Pages/Default.aspx" Visible="false">Dashboard</asp:HyperLink>
                        <asp:HyperLink ID="PublicApprovalsLink" runat="server" NavigateUrl="~/Pages/Approvals.aspx" Visible="false">Approvals</asp:HyperLink>
                        <asp:HyperLink ID="PublicApplicationsLink" runat="server" NavigateUrl="~/Pages/Applications.aspx" Visible="false">Contractor applications</asp:HyperLink>
                        <asp:HyperLink ID="MyApplicationsLink" runat="server" NavigateUrl="~/Pages/MyApplications.aspx" Visible="false">My applications</asp:HyperLink>
                        <asp:HyperLink ID="PublicWorkflowLink" runat="server" NavigateUrl="~/Pages/TenderWorkflow.aspx" Visible="false">My workflow queue</asp:HyperLink>
                        <asp:HyperLink ID="PublicTenderLifecycleLink" runat="server" NavigateUrl="~/Pages/TenderLifecycle.aspx" Visible="false">Publication and extensions</asp:HyperLink>
                        <asp:HyperLink ID="PublicTenderEvaluationLink" runat="server" NavigateUrl="~/Pages/TenderEvaluation.aspx" Visible="false">Bid opening and evaluation</asp:HyperLink>
                        <asp:HyperLink ID="PublicAdminLink" runat="server" NavigateUrl="~/Pages/Admin.aspx" Visible="false">Administration</asp:HyperLink>
                        <asp:HyperLink ID="ProfileLink" runat="server" NavigateUrl="~/Pages/Profile.aspx" Visible="false">Profile</asp:HyperLink>
                        <asp:HyperLink ID="LoginLink" runat="server" NavigateUrl="~/Pages/Login.aspx">Login</asp:HyperLink>
                        <asp:HyperLink ID="RegisterLink" runat="server" NavigateUrl="~/Pages/Register.aspx">Register</asp:HyperLink>
                        <asp:Literal ID="PublicCurrentUser" runat="server" />
                        <asp:LinkButton ID="PublicSignOutLink" runat="server" OnClick="SignOutLink_Click" Visible="false">Sign out</asp:LinkButton>
                    </nav>
                </header>
                <main class="container">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
                <footer class="footer">
                    <section id="portal-about">
                        <h2>About</h2>
                        <p>This portal supports Solapur Municipal Corporation tender publication and contractor application workflows.</p>
                        <ul>
                            <li><a href="#portal-about">About SMC</a></li>
                            <li><a href="#portal-about">About Tender Portal</a></li>
                            <li><a href="#portal-contact">Contact Us</a></li>
                        </ul>
                    </section>
                    <section>
                        <h2>Quick links</h2>
                        <ul>
                            <li><a href="<%= ResolveUrl("~/Pages/Home.aspx") %>">Home</a></li>
                            <li><a href="<%= ResolveUrl("~/Pages/Home.aspx?tenderStatus=open#published-tenders") %>">Active Tenders</a></li>
                            <li><a href="<%= ResolveUrl("~/Pages/Home.aspx#announcements") %>">Corrigendum and notices</a></li>
                            <li><a href="<%= ResolveUrl("~/Pages/Home.aspx?tenderStatus=completed#published-tenders") %>">Tender Results</a></li>
                            <li><a href="<%= ResolveUrl("~/Pages/Terms.aspx") %>">Help / User Guide</a></li>
                            <li><a href="<%= ResolveUrl("~/Pages/Terms.aspx#portal-faq") %>">FAQs</a></li>
                        </ul>
                    </section>
                    <section>
                        <h2>Important information</h2>
                        <ul>
                            <li><a href="<%= ResolveUrl("~/Pages/Terms.aspx") %>">Terms and Conditions</a></li>
                            <li><a href="<%= ResolveUrl("~/Pages/Terms.aspx#portal-policies") %>">Privacy Policy</a></li>
                            <li><a href="<%= ResolveUrl("~/Pages/Terms.aspx#portal-policies") %>">Disclaimer</a></li>
                            <li><a href="<%= ResolveUrl("~/Pages/Terms.aspx#portal-policies") %>">Accessibility Statement</a></li>
                        </ul>
                    </section>
                    <section id="portal-contact">
                        <h2>Contact information</h2>
                        <p>Solapur Municipal Corporation</p>
                        <p>The project does not contain a verified official address, telephone number, or email address.</p>
                    </section>
                    <div class="footer-bottom">
                        <span>&copy; <%= DateTime.Now.Year %> Solapur Municipal Corporation | Project & tender Portal</span>
                        <span>Portal ownership: Solapur Municipal Corporation</span>
                    </div>
                </footer>
            </div>
        </div>
        <button type="button" id="PublicNavScrim" class="public-nav-scrim" aria-label="Close navigation menu" tabindex="-1"></button>
        <script>
            (function () {
                var toggle = document.getElementById("SidebarToggle");
                var desktopToggle = document.getElementById("SidebarCollapseToggle");
                var sidebar = document.getElementById("AdminSidebar");
                var scrim = document.getElementById("SidebarScrim");
                var appLayout = document.getElementById("AppLayout");
                if (!sidebar || !toggle || !desktopToggle || !appLayout || sidebar.style.display === "none") return;

                function isMobileSidebar() {
                    return window.matchMedia("(max-width: 1023px)").matches;
                }

                function isSidebarOpen() {
                    return isMobileSidebar()
                        ? document.body.classList.contains("sidebar-open")
                        : !appLayout.classList.contains("sidebar-collapsed");
                }

                function setSidebarOpen(isOpen) {
                    if (isMobileSidebar()) {
                        appLayout.classList.remove("sidebar-collapsed");
                        document.body.classList.toggle("sidebar-open", isOpen);
                    } else {
                        document.body.classList.remove("sidebar-open");
                        appLayout.classList.toggle("sidebar-collapsed", !isOpen);
                    }
                    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                    toggle.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu");
                    desktopToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                    desktopToggle.setAttribute("aria-label", isMobileSidebar()
                        ? "Close navigation menu"
                        : (isOpen ? "Collapse sidebar" : "Expand sidebar"));
                    desktopToggle.setAttribute("title", isMobileSidebar()
                        ? "Close navigation menu"
                        : (isOpen ? "Collapse sidebar" : "Expand sidebar"));
                }

                toggle.addEventListener("click", function () {
                    setSidebarOpen(!isSidebarOpen());
                });
                desktopToggle.addEventListener("click", function () {
                    setSidebarOpen(isMobileSidebar() ? false : !isSidebarOpen());
                });
                scrim.addEventListener("click", function () { setSidebarOpen(false); });
                sidebar.addEventListener("click", function (event) {
                    if (isMobileSidebar() && event.target.closest("a")) setSidebarOpen(false);
                });
                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape" && isSidebarOpen()) setSidebarOpen(false);
                });
                window.addEventListener("resize", function () {
                    if (isMobileSidebar()) {
                        appLayout.classList.remove("sidebar-collapsed");
                    } else {
                        document.body.classList.remove("sidebar-open");
                    }
                    toggle.setAttribute("aria-expanded", isSidebarOpen() ? "true" : "false");
                    desktopToggle.setAttribute("aria-expanded", isSidebarOpen() ? "true" : "false");
                });
            }());

            (function () {
                var toggle = document.getElementById("PublicNavToggle");
                var close = document.getElementById("PublicNavClose");
                var navigation = document.getElementById("PublicNavigation");
                var scrim = document.getElementById("PublicNavScrim");
                if (!toggle || !navigation || navigation.closest(".workspace-layout")) return;

                function setPublicNavigationOpen(isOpen) {
                    document.body.classList.toggle("public-nav-open", isOpen);
                    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                    toggle.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu");
                    if (isOpen && navigation.querySelector("a")) navigation.querySelector("a").focus();
                }

                toggle.addEventListener("click", function () {
                    setPublicNavigationOpen(!document.body.classList.contains("public-nav-open"));
                });
                if (close) close.addEventListener("click", function () { setPublicNavigationOpen(false); toggle.focus(); });
                if (scrim) scrim.addEventListener("click", function () { setPublicNavigationOpen(false); toggle.focus(); });
                navigation.addEventListener("click", function (event) {
                    if (event.target.closest("a")) setPublicNavigationOpen(false);
                });
                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape" && document.body.classList.contains("public-nav-open")) {
                        setPublicNavigationOpen(false);
                        toggle.focus();
                    }
                });
            }());
        </script>
        <script src="<%= ResolveUrl("~/Scripts/ListEnhancements.js?v=20261126-1") %>"></script>
    </form>
</body>
</html>
